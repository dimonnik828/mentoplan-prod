    } = body;

    // Валидация обязательных полей
    if (!address || !revenue || !staffCount) {
      return NextResponse.json(
        { error: 'Необходимо указать адрес, выручку и количество сотрудников' },
        { status: 400 }
      );
    }

    const inputData: BusinessInput = {
